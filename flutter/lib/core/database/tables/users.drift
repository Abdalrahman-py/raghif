-- Local mirror of Supabase `public.profiles`, for the account signed in on
-- this device plus any buyer whose name the owner's screens need to show.
--
-- `id` is the Supabase auth user UUID. No pin_hash: PIN verification happens
-- server-side in the auth-gateway Edge Function, and a cache has no business
-- holding credential material.
CREATE TABLE users (
    id TEXT NOT NULL PRIMARY KEY,
    phone TEXT NOT NULL DEFAULT '',
    national_id TEXT NOT NULL DEFAULT '',
    name TEXT NOT NULL DEFAULT '',
    role TEXT NOT NULL DEFAULT 'buyer',
    jawwal_pay_number TEXT,
    verification_status TEXT NOT NULL DEFAULT 'pending'
);
