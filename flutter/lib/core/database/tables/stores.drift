-- Local mirror of Supabase `public.stores`. This table is a cache: rows only
-- ever arrive from the server via QueueSyncService, never from local writes,
-- and dropping the whole database costs nothing but a refetch.
--
-- `id` is the Supabase UUID verbatim. There is no separate local id and no
-- remote_id mapping column any more -- one id means the same thing on the
-- device, on the server and inside a QR code.
CREATE TABLE stores (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    -- Supabase profiles UUID of the owner. NULL for the browse-only demo
    -- bakeries, which nobody signs in to manage.
    owner_id TEXT NULL,
    is_open BOOLEAN NOT NULL DEFAULT FALSE,
    daily_bag_limit INTEGER NOT NULL DEFAULT 0,
    bags_remaining INTEGER NOT NULL DEFAULT 0,
    -- "HH:mm" 24h, owner-set. Informational for buyers; doesn't gate is_open.
    open_time TEXT NULL,
    close_time TEXT NULL,
    -- How many queue positions make up one notify-able batch. The server
    -- assigns each purchase its batch_number from this at reserve time.
    batch_size INTEGER NOT NULL DEFAULT 20,
    area TEXT NOT NULL DEFAULT ''
);
