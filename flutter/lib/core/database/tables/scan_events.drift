import 'purchases.drift';
import 'stores.drift';

-- Local mirror of Supabase `public.scan_events`: one row per QR scan attempt
-- at pickup. `outcome` holds the QrRedemptionOutcome name (checkedIn,
-- alreadyCollected, batchNotCalledYet, notFoundHere, wrongStore) or
-- 'invalidCode' when the code couldn't be parsed -- those leave purchase_id
-- null.
CREATE TABLE scan_events (
    id TEXT NOT NULL PRIMARY KEY,
    store_id TEXT NOT NULL REFERENCES stores (id),
    purchase_id TEXT NULL REFERENCES purchases (id),
    outcome TEXT NOT NULL,
    scanned_name TEXT NULL,
    scanned_national_id TEXT NULL,
    scanned_at INTEGER NOT NULL
);
