import 'stores.drift';
import 'users.drift';

-- Local mirror of Supabase `public.store_pins`: stores a buyer pinned to the
-- top of their own list. Server-side so the order survives a reinstall and
-- follows the buyer to a second handset.
CREATE TABLE store_pins (
    user_id TEXT NOT NULL REFERENCES users (id),
    store_id TEXT NOT NULL REFERENCES stores (id),
    created_at INTEGER NOT NULL,
    PRIMARY KEY (user_id, store_id)
);
